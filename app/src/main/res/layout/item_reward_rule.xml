<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/hu_line"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/hu_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <!-- Rule name -->
        <TextView
            android:id="@+id/tvRuleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_extrabold"
            android:textColor="@color/hu_ink"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/switchActive"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="A coffee, on us." />

        <!-- Rule description -->
        <TextView
            android:id="@+id/tvRuleDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_medium"
            android:textColor="@color/hu_soft"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/switchActive"
            app:layout_constraintTop_toBottomOf="@id/tvRuleName"
            tools:text="Redeem a free hot kopi with any purchase." />

        <!-- Points required -->
        <TextView
            android:id="@+id/tvPointsRequired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nav_pill_active"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/hu_ink"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRuleDescription"
            tools:text="200 pts required" />

        <!-- Active switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:showText="false"
            app:thumbTint="@color/hu_accent"
            app:trackTint="@color/hu_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnEdit" />

        <!-- Edit icon button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Widget.HU.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Edit rule"
            android:text="@string/reward_rule_edit"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconSize="14dp"
            app:iconTint="@color/hu_ink"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchActive"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
