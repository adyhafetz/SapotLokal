<?xml version="1.0" encoding="utf-8"?>
<!-- Weekly mission card (brand design "challenge-card"). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HU.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/missionIconBox"
                android:background="@drawable/bg_hu_icon_tile">

                <ImageView
                    android:id="@+id/ivMissionIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_store"
                    app:tint="@color/hu_ink" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRewardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_hu_icon_tile"
                android:fontFamily="@font/figtree_medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hu_ink"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="+100 points" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvMissionType"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/figtree_medium"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/hu_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Explore" />

        <TextView
            android:id="@+id/tvChallengeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_bold"
            android:textColor="@color/hu_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Tapah Explorer" />

        <TextView
            android:id="@+id/tvChallengeDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/figtree_medium"
            android:textColor="@color/hu_soft"
            android:textSize="13sp"
            tools:text="Visit 3 different local shops this week" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/tvProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:textColor="@color/hu_ink"
                android:textSize="12sp"
                tools:text="1 / 3 completed" />

            <TextView
                android:id="@+id/tvCountdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/figtree_medium"
                android:textColor="@color/hu_soft"
                android:textSize="12sp"
                tools:text="In progress" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/pbChallenge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_hu_progress" />

        <TextView
            android:id="@+id/tvBadgeRewardPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hu_icon_tile"
            android:fontFamily="@font/figtree_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/hu_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Badge: Regular" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaimReward"
            style="@style/Widget.HU.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/challenge_card_collect_your_reward"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartNow"
            style="@style/Widget.HU.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/challenge_card_get_started" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/hu_fill"
            android:fontFamily="@font/figtree_medium"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textColor="@color/hu_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Reward collected" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
