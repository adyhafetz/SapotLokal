<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Status pill: Unlocked or Locked -->
    <TextView
        android:id="@+id/tvBadgeStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_success"
        android:fontFamily="@font/figtree_medium"
        android:letterSpacing="0.08"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/badge_details_unlocked"
        android:textColor="@color/hu_ok"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Badge Icon -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivBadgeIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:contentDescription="Badge Icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_badge_first_scan" />

        <ImageView
            android:id="@+id/ivBadgeLockOverlay"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Locked"
            android:padding="6dp"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:tint="@color/hu_soft"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Badge Title -->
    <TextView
        android:id="@+id/tvBadgeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:text="@string/badge_details_langkah_kanan"
        android:textColor="@color/hu_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Unlock Criteria Description -->
    <TextView
        android:id="@+id/tvBadgeDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/figtree_medium"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/badge_details_scanned_your_first_shop"
        android:textColor="@color/hu_soft"
        android:textSize="14sp" />

    <!-- Dismiss button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissBadgeDialog"
        style="@style/Widget.HU.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/badge_details_got_it"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/radius_control" />

</LinearLayout>

