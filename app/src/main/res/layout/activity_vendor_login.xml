<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/sapot_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="36dp">

        <!-- Logo -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_nav_pill_active">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_brand_logo"
                android:contentDescription="SapotLokal logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVendorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/manrope"
            android:text="@string/vendor_login_shop_owner_login"
            android:textColor="@color/sapot_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVendorSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/vendor_login_log_in_to_manage"
            android:textColor="@color/sapot_text_secondary"
            android:textSize="14sp" />

        <!-- Business Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVendorEmail"
            style="@style/Widget.SapotLokal.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/vendor_login_registered_business_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVendorEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:inputType="textEmailAddress"
                android:textColor="@color/sapot_text_primary"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVendorPassword"
            style="@style/Widget.SapotLokal.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_password"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/sapot_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVendorPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:inputType="textPassword"
                android:textColor="@color/sapot_text_primary"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot password link -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/dm_sans"
            android:padding="8dp"
            android:text="@string/forgot_password"
            android:textColor="@color/sapot_primary"
            android:textSize="13sp" />

        <!-- Log In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVendorLogin"
            style="@style/Widget.SapotLokal.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/vendor_login_log_in"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/radius_control" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/sapot_primary"
            android:visibility="gone" />

        <!-- 1. Link back to Customer Login -->
        <TextView
            android:id="@+id/tvBackToCustomerLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/dm_sans"
            android:padding="8dp"
            android:text="@string/vendor_login_not_a_shop_owner"
            android:textColor="@color/sapot_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 2. Vendor registration link ONLY appears here -->
        <TextView
            android:id="@+id/tvRegisterVendor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/dm_sans"
            android:padding="8dp"
            android:text="@string/vendor_login_new_here_register_vendor"
            android:textColor="@color/sapot_text_secondary"
            android:textSize="13sp" />

        <!-- Language: EN | BM -->
        <include
            android:id="@+id/languageToggle"
            layout="@layout/layout_language_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>