<?xml version="1.0" encoding="utf-8"?>
<!--
    Customer Home (Hadiah Utama) — one job: "is anything ready for me?"
    Header (name opens Me) → level score with ticked bar → one big reward card
    → more-ready link → your top shops → Today in Play → bottom bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical"
    tools:context=".ui.customer.CustomerHomeActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Header: greeting + name, opens Me -->
            <LinearLayout
                android:id="@+id/btnMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_hu_logo"
                    android:backgroundTint="@color/hu_fill"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreetingTime"
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Selamat pagi" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        style="@style/HU.Text.Screen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_chevron_right_small"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="24sp"
                        tools:text="Farah Hassan" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rank card (shared with Play and Me) -->
            <include
                android:id="@+id/rankCard"
                layout="@layout/view_rank_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/btnHowPoints"
                style="@style/HU.Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/hu_how_points_work" />

            <!-- Unclaimed weekly top-3 prize (PrizeCard) -->
            <FrameLayout
                android:id="@+id/prizeSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- The one big reward card (or first-scan card) -->
            <FrameLayout
                android:id="@+id/readySlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/tvMoreReady"
                style="@style/HU.Text.Link"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:visibility="gone"
                tools:text="2 more ready · See Rewards"
                tools:visibility="visible" />

            <!-- Load error -->
            <LinearLayout
                android:id="@+id/errorBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hu_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/HU.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hu_load_error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.HU.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hu_try_again" />
            </LinearLayout>

            <!-- Your shops -->
            <LinearLayout
                android:id="@+id/shopsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HU.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/hu_your_shops" />

                <TextView
                    android:id="@+id/btnAllShops"
                    style="@style/HU.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:text="@string/hu_all_shops" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shopCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Today in Play -->
            <LinearLayout
                android:id="@+id/playStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_hu_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wheel"
                    app:tint="@color/hu_accent_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HU.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hu_today_in_play"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPlayLine"
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Free spin ready · Loyal Supporter 1 of 2" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right_small"
                    app:tint="@color/hu_soft" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/customerNav"
        layout="@layout/layout_customer_bottom_nav" />
</LinearLayout>
