<?xml version="1.0" encoding="utf-8"?>
<!-- Vendor "Shop profile" tab: photo, details and account actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical"
    tools:context=".ui.vendor.ShopProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_extrabold"
                android:text="@string/owner_nav_shop"
                android:textColor="@color/hu_ink"
                android:textSize="26sp" />

            <!-- Photo + name -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:id="@+id/photoFrame"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_nav_pill_active"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivShopPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Shop photo"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:id="@+id/photoPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_store"
                                app:tint="@color/hu_soft" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/figtree_medium"
                                android:text="@string/shop_profile_add_a_shop_photo"
                                android:textColor="@color/hu_soft"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_bold"
                        android:padding="8dp"
                        android:text="@string/shop_profile_change_photo"
                        android:textColor="@color/hu_accent_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/figtree_extrabold"
                        android:textColor="@color/hu_ink"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvProfileCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_medium"
                        android:textColor="@color/hu_soft"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateProfile"
                        style="@style/Widget.HU.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/shop_profile_update_profile" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shop_profile_category" />

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/shop_profile_address" />

                    <TextView
                        android:id="@+id/tvDetailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/shop_profile_opening_hours" />

                    <TextView
                        android:id="@+id/tvDetailHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/shop_profile_ssm_registration_number" />

                    <TextView
                        android:id="@+id/tvDetailSsm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rowChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:text="@string/shop_profile_change_password"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/hu_line" />

                    <TextView
                        android:id="@+id/rowLogout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:text="@string/shop_profile_log_out"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/hu_line" />

                    <TextView
                        android:id="@+id/rowDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:text="@string/shop_profile_delete_account"
                        android:textColor="@color/hu_danger"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Language -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/customer_profile_language"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp" />

                    <include
                        android:id="@+id/languageToggle"
                        layout="@layout/layout_language_toggle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/vendorNav"
        layout="@layout/layout_vendor_bottom_nav" />
</LinearLayout>
