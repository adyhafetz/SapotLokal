<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sapot_canvas">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sapot_canvas"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/sapot_canvas"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/sapot_text_primary"
            app:title="@string/vt_shop_settings"
            app:titleTextAppearance="@style/TextAppearance.SapotLokal.PageTitle"
            app:titleTextColor="@color/sapot_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:text="@string/shop_profile_update_profile"
                android:textColor="@color/sapot_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Shop Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilShopName"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                android:hint="@string/shop_settings_shop_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etShopName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/sapot_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shop Category -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilShopCategory"
                style="@style/Widget.SapotLokal.TextInputLayout"

                app:endIconMode="dropdown_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                android:hint="@string/label_shop_category">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etShopCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:textColor="@color/sapot_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shop Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilShopAddress"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                android:hint="@string/shop_settings_shop_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etShopAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:textColor="@color/sapot_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shop Description -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilShopDesc"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                android:hint="@string/shop_settings_shop_description_tagline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etShopDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:textColor="@color/sapot_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Operating Hours -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOperatingHours"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:startIconDrawable="@drawable/ic_clock"
                app:startIconTint="@color/sapot_text_secondary"
                app:helperText="e.g. 8:00 AM - 10:00 PM (Daily)"
                android:hint="@string/shop_settings_operating_hours">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOperatingHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/sapot_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SSM Registration Number (Read-only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSsmNumber"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                android:enabled="false"
                app:helperText="SSM Registration Number is locked for business compliance"
                android:hint="@string/shop_settings_ssm_registration_number">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSsmNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save Button & Progress -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.SapotLokal.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/shop_settings_save_changes"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_control" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/sapot_canvas"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
