<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/hu_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/signup_vendor_title"
            android:textColor="@color/hu_ink"
            android:textSize="24sp" />

        <!-- ── Account Details ──────────────────────────────────── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="0.05"
            android:text="@string/signup_vendor_account"
            android:textColor="@color/hu_soft"
            android:textSize="11sp" />

        <!-- Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/hu_ink"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="textEmailAddress"
                android:textColor="@color/hu_ink"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_password"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/hu_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="textPassword"
                android:textColor="@color/hu_ink"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Shop Details ─────────────────────────────────────── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="0.05"
            android:text="@string/signup_vendor_shop"
            android:textColor="@color/hu_soft"
            android:textSize="11sp" />

        <!-- Shop Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilShopName"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_shop_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etShopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="textCapWords"
                android:textColor="@color/hu_ink"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Shop Category -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilShopCategory"
            style="@style/Widget.HU.TextInputLayout"

            app:endIconMode="dropdown_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_shop_category">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etShopCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="none"
                android:paddingStart="16dp"
                android:textColor="@color/hu_ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Shop Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilShopAddress"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_shop_address">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etShopAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="@color/hu_ink"
                android:minLines="2"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── SSM Registration Number ──────────────────────────── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="0.05"
            android:text="@string/signup_vendor_business"
            android:textColor="@color/hu_soft"
            android:textSize="11sp" />

        <!-- SSM Number — REQUIRED per build guide Rule 6 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSsmNumber"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:hint="@string/label_ssm_number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSsmNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:inputType="textCapCharacters"
                android:textColor="@color/hu_ink"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SSM help text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/figtree_medium"
            android:text="@string/ssm_help"
            android:textColor="@color/hu_soft"
            android:textSize="12sp" />

        <!-- Sign Up button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            style="@style/Widget.HU.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/sign_up"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/hu_radius_control" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/hu_accent"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
