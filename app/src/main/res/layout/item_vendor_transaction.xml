<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/hu_bg"
    app:cardCornerRadius="@dimen/hu_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/hu_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nav_pill_active">

            <ImageView
                android:id="@+id/ivTxIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_store"
                app:tint="@color/hu_ink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_extrabold"
                android:textColor="@color/hu_ink"
                android:textSize="14sp"
                tools:text="Customer Visit Scan" />

            <TextView
                android:id="@+id/tvTxSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree_medium"
                android:textColor="@color/hu_soft"
                android:textSize="12sp"
                tools:text="Customer ID: usr_a1b2c3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTxPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_extrabold"
            android:textColor="@color/hu_ink"
            android:textSize="14sp"
            tools:text="+10 pts" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

