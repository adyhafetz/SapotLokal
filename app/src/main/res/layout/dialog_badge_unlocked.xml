<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Header badge pill -->
    <TextView
        android:id="@+id/tvBadgeHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_accent"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="✨ NEW BADGE UNLOCKED!"
        android:textColor="@color/sapot_on_primary"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <!-- Badge Icon with glow effect -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivBadgeGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_badge_glow"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/ivBadgeIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:contentDescription="Unlocked Badge Icon"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_badge_first_scan" />
    </FrameLayout>

    <!-- Badge Title -->
    <TextView
        android:id="@+id/tvBadgeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/sapot_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Langkah Kanan" />

    <!-- Badge Description -->
    <TextView
        android:id="@+id/tvBadgeDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/sapot_text_secondary"
        android:textSize="14sp"
        tools:text="Scanned your first shop visit in Tapah!" />

    <!-- Primary Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAwesome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/sapot_primary"
        android:text="Awesome!"
        android:textAllCaps="false"
        android:textColor="@color/sapot_on_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp" />

</LinearLayout>

