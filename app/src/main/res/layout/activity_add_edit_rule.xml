<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sapot_canvas"
    tools:context=".ui.vendor.AddEditRuleActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sapot_canvas"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/sapot_text_primary"
            app:title="@string/vt_create_voucher"
            app:titleTextAppearance="@style/TextAppearance.SapotLokal.PageTitle"
            app:titleTextColor="@color/sapot_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/add_edit_rule_voucher_details"
                android:textColor="@color/sapot_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/dm_sans"
                android:text="@string/add_edit_rule_customers_earn_it_by"
                android:textColor="@color/sapot_text_secondary"
                android:textSize="12sp" />

            <!-- Reward name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRuleName"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/add_edit_rule_voucher_title"
                app:counterEnabled="true"
                app:counterMaxLength="60"
                app:helperText="e.g. A coffee, on us">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRuleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="textCapSentences"
                    android:maxLength="60" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Description -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRuleDesc"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/add_edit_rule_description_terms"
                app:counterEnabled="true"
                app:counterMaxLength="120">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRuleDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:maxLength="120"
                    android:gravity="top|start" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Points required -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPoints"
                style="@style/Widget.SapotLokal.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/add_edit_rule_points_required"
                app:suffixText="pts">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:inputType="numberSigned" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveRule"
                style="@style/Widget.SapotLokal.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:text="@string/add_edit_rule_save_voucher"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
