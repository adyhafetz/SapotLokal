<?xml version="1.0" encoding="utf-8"?>
<!-- Hadiah Utama: type ramp and controls for the customer app. -->
<resources>
    <!-- Type -->
    <style name="HU.Text" parent="">
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="fontFamily">@font/figtree_medium</item>
        <item name="android:textColor">@color/hu_ink</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="HU.Text.Big">            <!-- 530, 20 points: the big number -->
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">52sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HU.Text.Screen">         <!-- Screen title: Rewards, Shops, Play -->
        <item name="android:fontFamily">@font/figtree_extrabold</item>
        <item name="fontFamily">@font/figtree_extrabold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="HU.Text.Title">          <!-- Card and section titles -->
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="HU.Text.Reward">         <!-- Reward name on a reward card -->
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="HU.Text.Body">
        <item name="android:textColor">@color/hu_soft</item>
    </style>
    <style name="HU.Text.Small">
        <item name="android:textColor">@color/hu_soft</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="HU.Text.Section">        <!-- Section heading on a screen: sentence case, same voice as "Your shops" -->
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/hu_ink</item>
    </style>
    <style name="HU.Text.Link">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/hu_accent_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Card: white, hairline border, 18dp corners, no elevation. -->
    <style name="Widget.HU.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/hu_bg</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hu_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- Tiles and list rows (Play, Me) -->
    <style name="HU.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">120dp</item>
        <item name="android:background">@drawable/bg_hu_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="HU.TileIcon" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/hu_accent_text</item>
    </style>
    <style name="HU.TileTitle" parent="HU.Text.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="HU.TileSub" parent="HU.Text.Small">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="HU.ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/bg_hu_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="HU.ListRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="HU.Chevron" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_right_small</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Bottom bar -->
    <style name="HU.NavTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="HU.NavBar" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/bg_hu_nav_indicator</item>
    </style>
    <style name="HU.NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="HU.NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/hu_soft</item>
    </style>

    <!-- Buttons: orange filled for actions, outlined for secondary. Sentence case, 52dp. -->
    <style name="Widget.HU.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/hu_accent</item>
        <item name="android:textColor">@color/hu_ink</item>
        <item name="iconTint">@color/hu_ink</item>
        <item name="rippleColor">@color/hu_ripple</item>
        <item name="android:fontFamily">@font/figtree_extrabold</item>
        <item name="fontFamily">@font/figtree_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Widget.HU.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/hu_line</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/hu_ink</item>
        <item name="iconTint">@color/hu_ink</item>
        <item name="rippleColor">@color/hu_ripple</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
