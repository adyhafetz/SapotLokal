<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── Base SapotLokal TextAppearance (DM Sans) ────────────────────────── -->
    <style name="TextAppearance.SapotLokal" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <!-- PageTitle: 28sp, lineSpacingExtra 4sp, bold/extrabold (Manrope), textColor @color/sapot_text_primary -->
    <style name="TextAppearance.SapotLokal.PageTitle" parent="TextAppearance.SapotLokal">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sapot_text_primary</item>
    </style>

    <!-- SectionTitle: 18sp, bold (Manrope), textColor @color/sapot_text_primary -->
    <style name="TextAppearance.SapotLokal.SectionTitle" parent="TextAppearance.SapotLokal">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sapot_text_primary</item>
    </style>

    <!-- Eyebrow: 10sp, uppercase letter spacing, medium, textColor @color/sapot_text_secondary -->
    <style name="TextAppearance.SapotLokal.Eyebrow" parent="TextAppearance.SapotLokal">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sapot_text_secondary</item>
    </style>

    <!-- Body: 14sp, regular, textColor @color/sapot_text_primary -->
    <style name="TextAppearance.SapotLokal.Body" parent="TextAppearance.SapotLokal">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/sapot_text_primary</item>
    </style>

    <!-- Label: 12sp, bold, textColor @color/sapot_text_primary -->
    <style name="TextAppearance.SapotLokal.Label" parent="TextAppearance.SapotLokal">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sapot_text_primary</item>
    </style>

    <!-- Caption: 11sp, regular, textColor @color/sapot_text_secondary -->
    <style name="TextAppearance.SapotLokal.Caption" parent="TextAppearance.SapotLokal">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/sapot_text_secondary</item>
    </style>
</resources>
